{
  "name": "calendar",
  "version": "0.0.1-next.0",
  "package": "@solidiom/calendar",
  "components": ["Calendar", "RangeCalendar"],
  "capabilities": [
    {
      "name": "date-math",
      "version": 1,
      "default": "@solidiom/adapter-date-internationalized"
    }
  ],
  "dependencies": [
    "@solidiom/runtime"
  ],
  "source": {
    "entry": "src/index.tsx",
    "files": [
      "src/calendar-context.ts",
      "src/calendar.tsx",
      "src/range-calendar-context.ts",
      "src/range-calendar.tsx",
      "src/index.tsx"
    ]
  },
  "runtime": [
    "state/controllable-value"
  ]
}
