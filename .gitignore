# Dependencies
node_modules/

# Vitest cache inside node_modules (pnpm symlinks may track these)
**/.vite/

# Build outputs
dist/
build/
*.tsbuildinfo

# Nx
.nx/cache
.nx/workspace-data

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Test coverage and generated verification artifacts
coverage/
artifacts/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Playwright
test-results/
playwright-report/

# Astro
.astro/

# Misc
*.tgz


# RECIPE-005 computed-style parity harness — generated per test run
tests/recipe-parity/.generated/

# TanStack Router/Start — generated route tree (rebuilt by dev/build)
routeTree.gen.ts


# CLI-008 offline fixture — Verdaccio storage snapshot (regenerate with
# `tools/offline-fixture/run-offline-test.sh --prep`). Tens of MB of
# third-party tarballs, and platform-specific, so it is never committed.
tools/offline-fixture/.registry-snapshot/
tools/offline-fixture/storage/

# Scratch directory created by tools/assert-no-unverified.test.ts
.tmp/
.worktrees/

# Template preview artifacts — generated by sync-template-previews.ts at build time
apps/site/public/templates/__preview__/
