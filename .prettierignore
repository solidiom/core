# Prettier 3 already honours .gitignore, so build outputs, coverage,
# artifacts, and test reports do not need to be repeated here.

# Package manager lockfile
pnpm-lock.yaml

# Generated registry manifests — tools/registry-build.ts owns this output and
# must stay byte-stable for the registry determinism checks.
registry/*.json

# Nx local metadata
.nx/

# Frozen proof-of-concept baseline. SITE-001 requires apps/docs-astro-poc to
# stay byte-identical until CUT-002 archives and removes it, so it is excluded
# from the repository formatting gate rather than reformatted.
apps/docs-astro-poc/

# Generated changeset entries are authored by the changesets CLI
.changeset/*.md


# Generated axe scan report — tools/generate-axe-report.ts owns this output. Its
# markdown table padding differs from Prettier's, so the two rewrite each other
# indefinitely: formatting it makes the next generator run dirty the tree, and
# regenerating it fails format:check. Same rationale as registry/*.json above.
# docs/evidence/recipe-contract-audit.md is deliberately not listed — its
# generated output is already Prettier-clean.
docs/axe-scan-results.md
