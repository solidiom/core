#!/usr/bin/env sh
# SOL-008: Pre-commit hook to block accidental commits of .env files
# containing secrets. Install with: git config core.hooksPath tools/git-hooks

# Check staged files for .env patterns that should never be committed
BLOCKED_PATTERNS=".env .env.local .env.*.local"

for pattern in $BLOCKED_PATTERNS; do
  # Use git diff --cached to check only staged files
  MATCHES=$(git diff --cached --name-only --diff-filter=ACM | grep -E "^(\.env|\.env\.local|\.env\..+\.local)$" || true)
  if [ -n "$MATCHES" ]; then
    echo ""
    echo "ERROR: Attempting to commit secret-bearing files:"
    echo "$MATCHES" | sed 's/^/  /'
    echo ""
    echo "These files are in .gitignore and should NEVER be committed."
    echo "If you really need to do this, use --no-verify (not recommended)."
    echo ""
    exit 1
  fi
  break
done

# Verify staged files are Prettier-formatted; block the commit if any are not.
# Mirrors CI's `prettier --check` gate so drift is caught before it lands on a
# branch instead of failing later in the pipeline. Use `pnpm run format` to fix.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$STAGED_FILES" ]; then
  # --ignore-unknown skips files Prettier has no parser for (matching the old
  # behavior); Prettier still honors .prettierignore. NUL-delimit paths so
  # names with spaces are handled correctly.
  if ! git diff --cached --name-only --diff-filter=ACM -z \
    | xargs -0 npx prettier --check --ignore-unknown; then
    echo ""
    echo "ERROR: Staged files are not Prettier-formatted (see above)."
    echo "Run 'pnpm run format' (or 'npx prettier --write <files>') and re-stage."
    echo "To bypass (not recommended), commit with --no-verify."
    echo ""
    exit 1
  fi
fi
