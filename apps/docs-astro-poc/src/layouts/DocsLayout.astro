---
import Nav from "../components/Nav.astro"
import Search from "../components/Search.astro"
import "../styles/global.css"

interface Props {
  title?: string
}

const { title = "Solidiom Documentation" } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/">Solidiom</a>
      <Search />
    </header>
    <nav aria-label="Documentation">
      <Nav />
    </nav>
    <main>
      <article>
        <slot />
      </article>
    </main>
  </body>
</html>
