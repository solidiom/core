# ANALYTICS-003: Production analytics provider configuration.
# These values must NEVER be committed to source. They are injected by the
# deployment environment (Cloudflare Pages, Vercel, etc.) at build time.
#
# Copy this file to .env and fill in production values:
#   cp .env.example .env

# PostHog project API key (public, but not committed to avoid key rotation churn)
# Obtain from: PostHog → Project Settings → Project API Key
PUBLIC_POSTHOG_KEY=

# PostHog API host (default: https://us.i.posthog.com)
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Feature flags
# Set to "true" to enable analytics in preview deployments
PUBLIC_ANALYTICS_ENABLED_IN_PREVIEW=false
