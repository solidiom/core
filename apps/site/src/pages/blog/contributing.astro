---
import BaseLayout from "@layouts/BaseLayout.astro"
import { resolveLocale, type Locale } from "@lib/locale"

const locale: Locale = resolveLocale(Astro.url.pathname)
const isEs = locale === "es"
const prefix = locale === "es" ? "/es" : ""
const blogPath = `${prefix}/blog/`
---

<BaseLayout
  title={isEs ? "Cómo contribuir al blog" : "Contributing to the Blog"}
  description={
    isEs
      ? "Guía rápida para crear una nueva entrada en el blog de Solidiom y añadirte como autor."
      : "A quick guide to creating a new Solidiom blog post and adding yourself as an author."
  }
>
  <main class="contributing-page">
    <nav aria-label="Breadcrumb">
      <a href={blogPath} class="contributing-page__back">
        ← {isEs ? "Blog" : "Blog"}
      </a>
    </nav>

    <h1>{isEs ? "Cómo contribuir al blog" : "Contributing to the Blog"}</h1>

    <p>
      {isEs
        ? "¿Quieres escribir para el blog de Solidiom? Esta guía rápida te explica cómo añadirte como autor y crear tu primera entrada."
        : "Want to write for the Solidiom blog? This guide walks you through adding yourself as an author and publishing your first post."}
    </p>

    <section class="contributing-page__section">
      <h2>{isEs ? "1. Regístrate como autor" : "1. Add yourself as an author"}</h2>
      <p>
        {isEs
          ? "Añade una entrada en <code>apps/site/src/data/authors.json</code>. Cada entrada sigue este formato:"
          : "Add an entry to <code>apps/site/src/data/authors.json</code>. Each entry follows this format:"}
      </p>

      <div class="contributing-page__code-block">
        <pre><code class="language-json">{`{
  "id": "your-github-username",
  "name": "Your Full Name",
  "description": "Short bio (e.g. \"Solidiom core contributor\")",
  "avatar": "https://github.com/your-github-username.png",
  "github": "your-github-username",
  "linkedin": "your-linkedin-username",
  "website": "https://your-website.com"
}`}</code></pre>
      </div>

      <p class="contributing-page__note">
        <strong>{isEs ? "Nota:" : "Note:"}</strong>
        {isEs
          ? ' <code>id</code> debe ser único y se utiliza para hacer referencia a ti en los artículos. Los campos <code>linkedin</code> y <code>website</code> son opcionales.'
          : ' <code>id</code> must be unique and is used to reference you in articles. <code>linkedin</code> and <code>website</code> are optional.'}
      </p>
    </section>

    <section class="contributing-page__section">
      <h2>{isEs ? "2. Crea tu entrada" : "2. Create your post"}</h2>
      <p>
        {isEs
          ? "Todas las entradas se escriben en Markdown. Añade tu archivo en <code>apps/site/src/content/en/articles/</code> (o <code>es/articles/</code> para la versión en español)."
          : "All posts are written in Markdown. Add your file to <code>apps/site/src/content/en/articles/</code> (or <code>es/articles/</code> for Spanish)."}
      </p>

      <h3>{isEs ? "Nombre del archivo" : "File name"}</h3>
      <p>
        {isEs
          ? "Usa <code>YYYY-MM-DD-post-title.md</code> como nombre de archivo."
          : "Use <code>YYYY-MM-DD-post-title.md</code> as the file name."}
      </p>

      <h3>{isEs ? "Encabezado de la entrada" : "Post frontmatter"}</h3>
      <p>
        {isEs
          ? "El encabezado YAML en la parte superior del archivo define la fecha, los autores y los metadatos:"
          : "The YAML frontmatter at the top of your file sets the date, authors, and metadata:"}
      </p>

      <div class="contributing-page__code-block">
        <pre><code class="language-yaml">{`---
contentSchemaVersion: 1
title: "Your Post Title"
description: "A short description shown in the blog listing."
keywords: [solidiom, web, component]
locale: en
maturity: draft
date: "2026-08-10"
authors:
  - your-github-username
tags: [solidiom, architecture]
---

Your article content here...`}</code></pre>
      </div>

      <p class="contributing-page__note">
        <strong>{isEs ? "Nota:" : "Note:"}</strong>
        {isEs
          ? ' Los valores en <code>authors</code> deben coincidir con el <code>id</code> de una entrada en <code>authors.json</code>.'
          : ' The <code>authors</code> values must match an <code>id</code> entry in <code>authors.json</code>.'}
      </p>
    </section>

    <section class="contributing-page__section">
      <h2>{isEs ? "3. Cuerpo del artículo" : "3. Post body"}</h2>
      <p>
        {isEs
          ? "El formato del artículo es tuyo. Recomendamos añadir una separación de página después del primer párrafo para crear un resumen en la página principal del blog."
          : "The formatting of the article body is up to you. We recommend adding a page break after the opening paragraph to create a synopsis on the blog listing page."}
      </p>

      <div class="contributing-page__code-block">
        <pre><code class="language-markdown">{`Opening paragraph of your post...

<!-- more -->

Rest of the article content...`}</code></pre>
      </div>
    </section>

    <section class="contributing-page__section">
      <h2>{isEs ? "4. Campos disponibles" : "4. Available frontmatter fields"}</h2>

      <table class="contributing-page__table">
        <thead>
          <tr>
            <th>{isEs ? "Campo" : "Field"}</th>
            <th>{isEs ? "Tipo" : "Type"}</th>
            <th>{isEs ? "Descripción" : "Description"}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>contentSchemaVersion</code></td>
            <td><code>1</code></td>
            <td>{isEs ? "Versión del esquema de contenido." : "Content schema version."}</td>
          </tr>
          <tr>
            <td><code>title</code></td>
            <td><code>string</code></td>
            <td>{isEs ? "Título del artículo." : "Article title."}</td>
          </tr>
          <tr>
            <td><code>description</code></td>
            <td><code>string</code></td>
            <td>{isEs ? "Descripción corta para la lista del blog." : "Short description shown in the blog listing."}</td>
          </tr>
          <tr>
            <td><code>keywords</code></td>
            <td><code>string[]</code></td>
            <td>{isEs ? "Términos para búsqueda y SEO." : "Terms for search and SEO."}</td>
          </tr>
          <tr>
            <td><code>locale</code></td>
            <td><code>"en" | "es"</code></td>
            <td>{isEs ? "Idioma del artículo." : "Article locale."}</td>
          </tr>
          <tr>
            <td><code>date</code></td>
            <td><code>Date</code></td>
            <td>{isEs ? "Fecha de publicación en formato ISO." : "Publication date in ISO format."}</td>
          </tr>
          <tr>
            <td><code>authors</code></td>
            <td><code>string[]</code></td>
            <td>{isEs ? "IDs de autores desde authors.json." : "Author IDs from authors.json."}</td>
          </tr>
          <tr>
            <td><code>tags</code></td>
            <td><code>string[]</code></td>
            <td>{isEs ? "Etiquetas visibles en la entrada." : "Tags displayed on the article."}</td>
          </tr>
          <tr>
            <td><code>maturity</code></td>
            <td><code>"draft" | "beta" | "ga"</code></td>
            <td>{isEs ? "Nivel de madurez del contenido." : "Content maturity level."}</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="contributing-page__section">
      <h2>{isEs ? "5. Previsualiza y envía" : "5. Preview and submit"}</h2>
      <p>
        {isEs
          ? 'Desde la carpeta <code>apps/site/</code>, ejecuta <code>pnpm dev</code> para ver tu entrada en <code>http://localhost:4321/blog/tu-titulo/</code>.'
          : 'From the <code>apps/site/</code> directory, run <code>pnpm dev</code> to preview your post at <code>http://localhost:4321/blog/your-title/</code>.'}
      </p>
      <p>
        {isEs
          ? "Una vez satisfecho, abre un Pull Request con tus cambios. El equipo revisará la entrada antes de publicarla."
          : "Once you're happy, open a Pull Request with your changes. The team will review your post before it goes live."}
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .contributing-page {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .contributing-page__back {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--color-foreground-muted, #6b7280);
    text-decoration: none;
    margin-bottom: 1.5rem;
  }

  .contributing-page__back:hover {
    color: var(--focus-ring, #2563eb);
  }

  .contributing-page h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--color-foreground, #111827);
  }

  .contributing-page > p {
    font-size: 1.125rem;
    color: var(--color-foreground-muted, #6b7280);
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .contributing-page__section {
    margin-bottom: 3rem;
  }

  .contributing-page__section h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border, #e5e7eb);
    color: var(--color-foreground, #111827);
  }

  .contributing-page__section h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-foreground, #111827);
  }

  .contributing-page__section p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-body, #374151);
    margin-bottom: 1rem;
  }

  .contributing-page__section code {
    font-family: var(--font-mono, "IBM Plex Mono", monospace);
    font-size: 0.875em;
    background: var(--color-bg-muted, #f3f4f6);
    padding: 0.125em 0.375em;
    border-radius: 0.25rem;
  }

  .contributing-page__code-block {
    margin: 1rem 0 1.5rem;
    overflow-x: auto;
  }

  .contributing-page__code-block pre {
    background: var(--color-surface-raised, #1f2937);
    color: var(--color-foreground, #f9fafb);
    padding: 1.25rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
  }

  .contributing-page__code-block code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .contributing-page__note {
    font-size: 0.875rem;
    color: var(--color-foreground-muted, #6b7280);
    padding: 0.75rem 1rem;
    background: var(--color-bg-muted, #f9fafb);
    border-left: 3px solid var(--focus-ring, #2563eb);
    border-radius: 0 0.25rem 0.25rem 0;
    margin-top: 1rem;
  }

  .contributing-page__note strong {
    color: var(--color-foreground, #111827);
  }

  .contributing-page__table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.875rem;
  }

  .contributing-page__table thead {
    background: var(--color-bg-muted, #f3f4f6);
  }

  .contributing-page__table th {
    text-align: left;
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid var(--color-border, #e5e7eb);
    color: var(--color-foreground, #111827);
  }

  .contributing-page__table td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
    color: var(--color-body, #374151);
    vertical-align: top;
  }

  .contributing-page__table td code {
    font-family: var(--font-mono, "IBM Plex Mono", monospace);
    font-size: 0.8125rem;
    background: var(--color-bg-muted, #f3f4f6);
    padding: 0.125em 0.375em;
    border-radius: 0.25rem;
    white-space: nowrap;
  }
</style>
