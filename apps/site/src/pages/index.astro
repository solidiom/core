---
/**
 * Homepage — redesigned landing page.
 *
 * Showcases Solidiom's value proposition with a dark hero, feature pills,
 * a starting-layer chooser, trust logos, and ownership-focused messaging.
 */
import BaseLayout from "../layouts/BaseLayout.astro"
import type { Locale } from "../lib/locale"
import { resolveLocale } from "../lib/locale"

const locale: Locale = resolveLocale(Astro.url.pathname)
---

<BaseLayout description="Solidiom is a headless UI primitive system for Solid 2. Accessible behavior, idiomatic Solid.">
  <div class="homepage" data-pagefind-body data-pagefind-filter-locale="en" data-pagefind-filter-content_type="page" data-pagefind-meta="title:Solidiom">

    <!-- ═══════════════════════════════════════════════════════════════════
         HERO
         ═══════════════════════════════════════════════════════════════════ -->
    <section class="hero">
      <div class="hero__content">
        <span class="hero__badge">SOLID 2 -NATIVE</span>
        <h1 class="hero__title">
          Accessible behavior.<br/>
          <span class="hero__accent">Idiomatic Solid.</span>
        </h1>
        <p class="hero__subtitle">
          {locale === "en"
            ? "Solidiom is a headless UI primitive system for Solid 2. Behavior-first, runtime-first, zero mandatory styling dependencies."
            : "Solidiom es un sistema de primitivas UI headless para Solid 2. Comportamiento primero, runtime primero, sin dependencias de estilo obligatorias."}
        </p>
        <div class="hero__actions">
          <a href="/primitives/" class="hero__cta hero__cta--primary">Get Started</a>
          <a href="/primitives/" class="hero__cta hero__cta--secondary">Explore Primitives</a>
        </div>
        <div class="hero__install">
          <code>npm i @solidiom/core</code>
          <button class="hero__copy" aria-label="Copy install command" onclick="navigator.clipboard.writeText('npm i @solidiom/core')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          </button>
        </div>
      </div>
      <div class="hero__visual" aria-hidden="true">
        <!-- Abstract decorative grid visual -->
        <div class="hero__grid">
          <div class="hero__grid-cell hero__grid-cell--accent"></div>
          <div class="hero__grid-cell"></div>
          <div class="hero__grid-cell"></div>
          <div class="hero__grid-cell"></div>
          <div class="hero__grid-cell hero__grid-cell--highlight"></div>
          <div class="hero__grid-cell"></div>
          <div class="hero__grid-cell"></div>
          <div class="hero__grid-cell"></div>
          <div class="hero__grid-cell hero__grid-cell--primary"></div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════
         FEATURE PILLS
         ═══════════════════════════════════════════════════════════════════ -->
    <section class="features">
      <div class="features__grid">
        <div class="features__item">
          <div class="features__icon features__icon--solid">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <h3>Solid 2-native</h3>
          <p>Built for fine-grained reactivity.</p>
        </div>
        <div class="features__item">
          <div class="features__icon features__icon--a11y">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="4" r="2"/><path d="M12 6v14M6 10h12M8 20l4-4 4 4"/></svg>
          </div>
          <h3>Accessible by default</h3>
          <p>WAI-ARIA compliant out of the box.</p>
        </div>
        <div class="features__item">
          <div class="features__icon features__icon--headless">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3>Headless</h3>
          <p>Unstyled. Bring your own design system.</p>
        </div>
        <div class="features__item">
          <div class="features__icon features__icon--source">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h3>Source-owned</h3>
          <p>Copy, customize, and ship.</p>
        </div>
        <div class="features__item">
          <div class="features__icon features__icon--compose">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          </div>
          <h3>Composable</h3>
          <p>Build anything from primitives.</p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════
         STARTING LAYER
         ═══════════════════════════════════════════════════════════════════ -->
    <section class="layers">
      <header class="layers__header">
        <h2>Choose your starting layer</h2>
        <p>Go from low-level primitives to production-ready interfaces — at your pace.</p>
      </header>
      <div class="layers__grid">
        <article class="layers__card">
          <div class="layers__card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M3 9h18"/></svg>
          </div>
          <h3>Primitives</h3>
          <p>48 headless, accessible building blocks for any interface.</p>
          <a href="/primitives/" class="layers__link">Start Building →</a>
        </article>
        <article class="layers__card">
          <div class="layers__card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M12 12h.01"/><path d="M17 12h.01"/><path d="M7 12h.01"/></svg>
          </div>
          <h3>Components</h3>
          <p>32 styled, production-ready components you can copy and own.</p>
          <a href="/components/" class="layers__link">Browse Components →</a>
        </article>
        <article class="layers__card">
          <div class="layers__card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M2 10h20"/><path d="M10 2v20"/></svg>
          </div>
          <h3>Blocks</h3>
          <p>36 page-level patterns for authentication, billing, dashboards, and more.</p>
          <a href="/blocks/" class="layers__link">Explore Blocks →</a>
        </article>
        <article class="layers__card">
          <div class="layers__card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18"/><path d="M12 3v18"/><path d="M3 3l18 18"/></svg>
          </div>
          <h3>Templates</h3>
          <p>31 full application templates for SaaS, commerce, AI, and enterprise.</p>
          <a href="/templates/" class="layers__link">View Templates →</a>
        </article>
        <article class="layers__card">
          <div class="layers__card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a7 7 0 0 0 0 20"/><path d="M12 2a7 7 0 0 1 0 20"/><path d="M2 12h20"/></svg>
          </div>
          <h3>Themes</h3>
          <p>5 installable theme presets with light/dark support and CSS + Tailwind outputs.</p>
          <a href="/themes/" class="layers__link">Browse Themes →</a>
        </article>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════
         TRUSTED BY DEVELOPERS
         ═══════════════════════════════════════════════════════════════════ -->
    <section class="trust">
      <p class="trust__label">Trusted by developers</p>
      <p class="trust__sublabel">Loved by the Solid community.</p>
      <div class="trust__logos">
        <span class="trust__logo">Startree</span>
        <span class="trust__logo">vinxi</span>
        <span class="trust__logo">solidstart</span>
        <span class="trust__logo">TanStack</span>
        <span class="trust__logo">effect</span>
        <span class="trust__logo">deedle</span>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════
         CODE OWNERSHIP
         ═══════════════════════════════════════════════════════════════════ -->
    <section class="ownership">
      <header class="ownership__header">
        <h2>Code you own. Design you control.</h2>
      </header>
      <div class="ownership__grid">
        <article class="ownership__card">
          <div class="ownership__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          </div>
          <h3>Zero styling lock-in</h3>
          <p>Bring your own styles — CSS, Tailwind, or UnoCSS recipes included. No mandatory styling.</p>
        </article>
        <article class="ownership__card">
          <div class="ownership__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>Built for Solid 2</h3>
          <p>52 primitives, 32 components, 36 blocks — designed for fine-grained reactivity.</p>
        </article>
        <article class="ownership__card">
          <div class="ownership__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h3>Open Source</h3>
          <p>MIT licensed. Full source ownership. Fork, modify, ship.</p>
        </article>
      </div>
    </section>

  </div>
</BaseLayout>
