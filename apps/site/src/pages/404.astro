---
/**
 * 404 — Not Found (SITE-010).
 *
 * Static fallback page rendered when no route matches. Uses BaseLayout
 * with minimal chrome (header + footer) so the user can navigate away.
 * Error-safe: no dynamic data fetching, no islands, no external requests.
 * Works correctly even if JavaScript is disabled or fails.
 */
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout title="Page Not Found" description="The requested page could not be found.">
  <div class="error-page">
    <h1 class="error-page__code">404</h1>
    <p class="error-page__title">Page not found</p>
    <p class="error-page__description">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a href="/" class="error-page__link">Go to homepage</a>
  </div>
</BaseLayout>

<style>
  .error-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 50vh;
    padding: 2rem 1rem;
    gap: 0.75rem;
  }

  .error-page__code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-foreground-muted);
    margin: 0;
  }

  .error-page__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-foreground);
  }

  .error-page__description {
    color: var(--color-foreground-muted);
    font-size: 1rem;
    margin: 0;
    max-width: 28rem;
  }

  .error-page__link {
    display: inline-flex;
    align-items: center;
    margin-top: 1rem;
    padding: 0.625rem 1.25rem;
    border-radius: 0.375rem;
    background-color: var(--focus-ring);
    color: #ffffff;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.1s ease;
  }

  .error-page__link:hover {
    opacity: 0.9;
  }

  .error-page__link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .error-page__link {
      transition: none;
    }
  }
</style>
