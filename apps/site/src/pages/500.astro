---
/** Static server-error fallback artifact (SITE-010). */
import ErrorLayout from "../layouts/ErrorLayout.astro"
---

<ErrorLayout title="Service Unavailable" description="The requested page could not be served.">
  <div class="error-page">
    <h1 class="error-page__code">500</h1>
    <p class="error-page__title">Something went wrong</p>
    <p class="error-page__description">
      The page could not be served. Please return to the homepage and try again.
    </p>
    <a href="/" class="error-page__link">Go to homepage</a>
  </div>
</ErrorLayout>

<style>
  .error-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 50vh;
    padding: 2rem 1rem;
    text-align: center;
    gap: 0.75rem;
  }

  .error-page__code {
    color: var(--color-foreground-muted);
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 700;
    line-height: 1;
    margin: 0;
  }

  .error-page__title {
    color: var(--color-foreground);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
  }

  .error-page__description {
    color: var(--color-foreground-muted);
    font-size: 1rem;
    margin: 0;
    max-width: 28rem;
  }

  .error-page__link {
    align-items: center;
    background-color: var(--focus-ring);
    border-radius: 0.375rem;
    color: #ffffff;
    display: inline-flex;
    font-weight: 500;
    margin-top: 1rem;
    padding: 0.625rem 1.25rem;
    text-decoration: none;
  }
</style>
