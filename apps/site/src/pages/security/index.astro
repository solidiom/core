---
import { getEntry, render } from "astro:content"
import BaseLayout from "../../layouts/BaseLayout.astro"

const entry = await getEntry("pages", "en/pages/security")
if (!entry) throw new Error("Missing content: en/pages/security")
const { Content } = await render(entry)
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div
    class="prose"
    data-pagefind-body
    data-pagefind-filter-locale="en"
    data-pagefind-filter-content_type="page"
    data-pagefind-meta={`title:${entry.data.title}`}
  >
    <Content />
  </div>
</BaseLayout>
