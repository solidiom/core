---
import CatalogRoute from "../../../../components/CatalogRoute.astro"
import { getLayerViewPaths } from "../../../../lib/content-catalog"

export function getStaticPaths() {
  return getLayerViewPaths("blocks", "blocks", "es")
}

interface Props {
  collectionName: "blocks"
  layer: "blocks"
  entryId: string
  name: string
  locale: "es"
  view: "api" | "examples" | "accessibility"
}

const props = Astro.props
---

<CatalogRoute {...props} />