---
import CatalogRoute from "../../../../components/CatalogRoute.astro"
import { getLayerOverviewPaths } from "../../../../lib/content-catalog"

export function getStaticPaths() {
  return getLayerOverviewPaths("themes", "themes", "es")
}

interface Props {
  collectionName: "themes"
  layer: "themes"
  entryId: string
  name: string
  locale: "es"
}

const props = Astro.props
---

<CatalogRoute {...props} view="overview" />