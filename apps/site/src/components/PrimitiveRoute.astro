---
import { getCollection, render } from "astro:content"
import type { RegistryPrimitive, PrimitiveView } from "../lib/catalog"
import {
  getAccessibilityEvidence,
  getApiDocumentResult,
  getCatalogCopy,
  getRegistryManifest,
  getRegistryPrimitives,
  primitiveHref,
} from "../lib/catalog"
import { adjacentPrimitiveLinks, primitiveSidebarGroups, tocFromHeadings } from "../lib/docs-nav"
import type { Locale } from "../lib/locale"
import { catalogPageStructuredData, getCatalogSeoCopy } from "../lib/metadata"
import DocsLayout from "../layouts/DocsLayout.astro"
import AccessibilityEvidence from "./AccessibilityEvidence.astro"
import ApiReference from "./ApiReference.astro"
import CatalogBreadcrumbs from "./CatalogBreadcrumbs.astro"
import ExampleSource from "./ExampleSource.astro"
import PrimitiveExample from "./PrimitiveExample.astro"
import PrimitiveMetadata from "./PrimitiveMetadata.astro"
import PrimitiveTabs from "./PrimitiveTabs.astro"

interface Props {
  primitive: RegistryPrimitive
  locale: Locale
  view: PrimitiveView
}

const { primitive, locale, view } = Astro.props
const copy = getCatalogCopy(locale)
const seoCopy = getCatalogSeoCopy(locale)
const sectionTitle: Record<PrimitiveView, string> = {
  overview: copy.overview,
  api: copy.api,
  examples: copy.examples,
  accessibility: copy.accessibility,
}
const section = view === "overview" ? "overview" : view
const documents = await getCollection(
  "primitives",
  (entry) =>
    entry.data.primitive === primitive.name &&
    entry.data.locale === locale &&
    entry.data.section === section,
)
const document = documents.at(0)
const exampleDocuments =
  view === "examples"
    ? await getCollection(
        "examples",
        (entry) => entry.data.product === primitive.label && entry.data.locale === locale,
      )
    : []
const exampleSource = exampleDocuments.at(0)?.data.source
const renderedDocument = document ? await render(document) : undefined
const DocumentContent = renderedDocument?.Content
const pageDescription = document?.data.description ?? primitive.description
const title = view === "overview" ? primitive.label : `${primitive.label} ${sectionTitle[view]}`
const apiDocumentResult = view === "api" ? getApiDocumentResult(primitive.name) : undefined
const accessibilityEvidence =
  view === "accessibility" ? getAccessibilityEvidence(primitive.name) : undefined
const accessibilityContractEntries =
  view === "accessibility"
    ? await getCollection(
        "accessibilityContracts",
        (entry) => entry.data.primitive === primitive.name && entry.data.locale === locale,
      )
    : []
const accessibilityContract = accessibilityContractEntries.at(0)?.data
const hasExample =
  primitive.name in
  {
    accordion: 1,
    alert: 1,
    "alert-dialog": 1,
    avatar: 1,
    badge: 1,
    breadcrumb: 1,
    button: 1,
    calendar: 1,
    card: 1,
    carousel: 1,
    checkbox: 1,
    combobox: 1,
    "command-palette": 1,
    "context-menu": 1,
    "data-table": 1,
    "date-picker": 1,
    dialog: 1,
    drawer: 1,
    "empty-state": 1,
    field: 1,
    "hover-card": 1,
    input: 1,
    "input-otp": 1,
    kbd: 1,
    label: 1,
    listbox: 1,
    menu: 1,
    meter: 1,
    "navigation-menu": 1,
    pagination: 1,
    popover: 1,
    progress: 1,
    "radio-group": 1,
    "resizable-panels": 1,
    "scroll-area": 1,
    select: 1,
    separator: 1,
    sheet: 1,
    skeleton: 1,
    slider: 1,
    spinner: 1,
    switch: 1,
    tabs: 1,
    toast: 1,
    toggle: 1,
    "toggle-group": 1,
    toolbar: 1,
    tooltip: 1,
    tree: 1,
    "virtual-list": 1,
    "visually-hidden": 1,
  }
const registryManifest = getRegistryManifest(primitive.name)
const homePath = locale === "es" ? "/es/" : "/"
const directoryPath = locale === "es" ? "/es/primitives/" : "/primitives/"
const currentPath = primitiveHref(primitive.name, locale, view)
const breadcrumbItems = [
  { name: seoCopy.home, pathname: homePath },
  { name: copy.directoryTitle, pathname: directoryPath },
  ...(view === "overview"
    ? []
    : [{ name: primitive.label, pathname: primitiveHref(primitive.name, locale) }]),
  { name: view === "overview" ? primitive.label : sectionTitle[view], pathname: currentPath },
]
const structuredData = catalogPageStructuredData({
  title,
  description: pageDescription,
  pathname: currentPath,
  locale,
  breadcrumbs: breadcrumbItems,
})

const allPrimitives = getRegistryPrimitives()
const sidebarGroups = primitiveSidebarGroups(allPrimitives, locale, (name, loc) =>
  primitiveHref(name, loc),
)
const toc = tocFromHeadings(renderedDocument?.headings ?? [])
const { previous, next } = adjacentPrimitiveLinks(allPrimitives, primitive.name, (name) =>
  primitiveHref(name, locale, view),
)
---

<DocsLayout
  title={title}
  description={pageDescription}
  sidebarGroups={sidebarGroups}
  toc={toc}
  previous={previous}
  next={next}
  structuredData={structuredData}
  contentType="primitive"
>
  <CatalogBreadcrumbs
    label={seoCopy.breadcrumbs}
    items={breadcrumbItems.map((item, index) => ({
      label: item.name,
      href: index === breadcrumbItems.length - 1 ? undefined : item.pathname,
    }))}
  />
  <header class="primitive-header">
    <h1>{primitive.label}</h1>
    <p>{pageDescription}</p>
    <dl class="primitive-header__meta">
      <div><dt>{copy.package}</dt><dd><code>{primitive.package}</code></dd></div>
      <div><dt>{copy.version}</dt><dd><code>{primitive.version}</code></dd></div>
      <div><dt>{copy.status}</dt><dd>{primitive.status}</dd></div>
    </dl>
  </header>

  <PrimitiveTabs name={primitive.name} label={primitive.label} locale={locale} current={view} />

  {
    view === "overview" && (
      <section>
        <h2>{copy.preview}</h2>
        {hasExample && (
          <>
            <PrimitiveExample name={primitive.name} locale={locale} />
            <p class="preview-styling-note">
              {locale === "es"
                ? "Este ejemplo usa estilos solo para documentación. En producción, utiliza una de las recetas incluidas (CSS, Tailwind o UnoCSS)."
                : "This preview uses documentation-only styling. Ship with one of the included recipe outputs (CSS, Tailwind, or UnoCSS) for production styles."}
            </p>
          </>
        )}
        {DocumentContent ? <DocumentContent /> : <p>{primitive.description}</p>}
        <PrimitiveMetadata manifest={registryManifest} copy={copy} />
      </section>
    )
  }

  {view === "api" && <ApiReference result={apiDocumentResult} locale={locale} />}

  {
    view === "examples" && (
      <section>
        <h2>{copy.examples}</h2>
        {DocumentContent ? (
          <DocumentContent />
        ) : (
          <p class="catalog-notice" role="status">
            {copy.examplesUnavailable}
          </p>
        )}
        {hasExample && <PrimitiveExample name={primitive.name} locale={locale} />}
        {hasExample && <ExampleSource source={exampleSource} locale={locale} />}
      </section>
    )
  }

  {
    view === "accessibility" && (
      <section>
        <h2>{copy.accessibility}</h2>
        {DocumentContent ? (
          <DocumentContent />
        ) : (
          <p class="catalog-notice" role="status">
            {copy.accessibilityUnavailable}
          </p>
        )}
        <AccessibilityEvidence
          contract={accessibilityContract}
          evidence={accessibilityEvidence}
          locale={locale}
        />
      </section>
    )
  }
</DocsLayout>
