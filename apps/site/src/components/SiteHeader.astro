---
/** Hydrated Astro wrapper for the global SiteHeader Solid island. */
import { SiteHeader, type NavLink } from "./SiteHeader"
import { resolveEquivalentLocalePath, resolveLocale, type Locale } from "../lib/locale"

interface Props {
  links: NavLink[]
  docsLinks: NavLink[]
  docsLabel: string
  homeHref?: string
  /** Explicit server-resolved locale context from the containing layout. */
  locale?: Locale
}

const { links, docsLinks, docsLabel, homeHref, locale: providedLocale } = Astro.props
const pathname = Astro.url.pathname
const locale = providedLocale ?? resolveLocale(pathname)
const targetLocalePath = resolveEquivalentLocalePath(pathname, locale === "en" ? "es" : "en")
---

<SiteHeader
  links={links}
  docsLinks={docsLinks}
  docsLabel={docsLabel}
  pathname={pathname}
  homeHref={homeHref}
  locale={locale}
  alternatePath={targetLocalePath}
  client:load
/>
