---
/**
 * ComponentExample — renders the live Solid island for a component's interactive preview.
 *
 * Reuses the same *Example.tsx components as PrimitiveExample, keyed by component name.
 * Astro requires static imports for hydrated components, so we map component names
 * to their example components here and conditionally render the matching one.
 */
import { AccordionExample } from "./AccordionExample"
import { AlertExample } from "./AlertExample"
import { AlertDialogExample } from "./AlertDialogExample"
import { AvatarExample } from "./AvatarExample"
import { BadgeExample } from "./BadgeExample"
import { BreadcrumbExample } from "./BreadcrumbExample"
import { ButtonExample } from "./ButtonExample"
import { CalendarExample } from "./CalendarExample"
import { CardExample } from "./CardExample"
import { CarouselExample } from "./CarouselExample"
import { CheckboxExample } from "./CheckboxExample"
import { CollapsibleExample } from "./CollapsibleExample"
import { ComboboxExample } from "./ComboboxExample"
import { CommandPaletteExample } from "./CommandPaletteExample"
import { ContextMenuExample } from "./ContextMenuExample"
import { DataTableExample } from "./DataTableExample"
import { DatePickerExample } from "./DatePickerExample"
import { DialogExample } from "./DialogExample"
import { DrawerExample } from "./DrawerExample"
import { EmptyStateExample } from "./EmptyStateExample"
import { FieldExample } from "./FieldExample"
import { HoverCardExample } from "./HoverCardExample"
import { InputExample } from "./InputExample"
import { InputOtpExample } from "./InputOtpExample"
import { KbdExample } from "./KbdExample"
import { LabelExample } from "./LabelExample"
import { ListboxExample } from "./ListboxExample"
import { MenuExample } from "./MenuExample"
import { MeterExample } from "./MeterExample"
import { NavigationMenuExample } from "./NavigationMenuExample"
import { PaginationExample } from "./PaginationExample"
import { PopoverExample } from "./PopoverExample"
import { ProgressExample } from "./ProgressExample"
import { RadioGroupExample } from "./RadioGroupExample"
import { ResizablePanelsExample } from "./ResizablePanelsExample"
import { ScrollAreaExample } from "./ScrollAreaExample"
import { SelectExample } from "./SelectExample"
import { SheetExample } from "./SheetExample"
import { SkeletonExample } from "./SkeletonExample"
import { SliderExample } from "./SliderExample"
import { SpinnerExample } from "./SpinnerExample"
import { SwitchExample } from "./SwitchExample"
import { TabsExample } from "./TabsExample"
import { ToastExample } from "./ToastExample"
import { ToggleExample } from "./ToggleExample"
import { ToggleGroupExample } from "./ToggleGroupExample"
import { ToolbarExample } from "./ToolbarExample"
import { TooltipExample } from "./TooltipExample"
import { TreeExample } from "./TreeExample"
import { VirtualListExample } from "./VirtualListExample"

interface Props {
  name: string
  locale: string
}

const { name, locale } = Astro.props
---

{name === "accordion" && <AccordionExample locale={locale} client:visible />}
{name === "alert" && <AlertExample locale={locale} client:visible />}
{name === "alert-dialog" && <AlertDialogExample locale={locale} client:visible />}
{name === "avatar" && <AvatarExample locale={locale} client:visible />}
