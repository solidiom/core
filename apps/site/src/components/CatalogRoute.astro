---
import { getCollection, render } from "astro:content"
import type { Locale } from "../lib/locale"
import type { CatalogView, CatalogLayer } from "../lib/catalog"
import { getLayerCopy, layerHref, entryName } from "../lib/catalog"
import { getCatalogSeoCopy } from "../lib/metadata"
import type { DocsSidebarGroup } from "../lib/docs-nav"
import DocsLayout from "../layouts/DocsLayout.astro"
import CatalogBreadcrumbs from "./CatalogBreadcrumbs.astro"
import ComponentExample from "./ComponentExample.astro"

interface Props {
  collectionName: "components" | "blocks" | "templates" | "themes"
  layer: CatalogLayer
  entryId: string
  name: string
  locale: Locale
  view: CatalogView
}

const { collectionName, layer, entryId, name, locale, view } = Astro.props
const copy = getLayerCopy(locale, layer)
const seoCopy = getCatalogSeoCopy(locale)
const sectionTitle: Record<CatalogView, string> = {
  overview: copy.overview,
  api: copy.api,
  examples: copy.examples,
  accessibility: copy.accessibility,
}

const [document] = await getCollection(
  collectionName,
  (entry) => entry.id === entryId && entry.data.locale === locale,
)
const renderedDocument = document ? await render(document) : undefined
const DocumentContent = renderedDocument?.Content
const pageDescription = document?.data.description ?? name
const title =
  view === "overview"
    ? (document?.data.title ?? name)
    : `${document?.data.title ?? name} ${sectionTitle[view]}`

const COMPONENTS_WITH_EXAMPLES = new Set([
  "accordion", "alert", "alert-dialog", "avatar", "badge", "breadcrumb", "button",
  "calendar", "card", "carousel", "checkbox", "collapsible", "combobox",
  "command-palette", "context-menu", "data-table", "date-picker", "dialog",
  "drawer", "empty-state", "field", "hover-card", "input", "input-otp",
  "kbd", "label", "listbox", "menu", "meter", "navigation-menu", "pagination",
  "popover", "progress", "radio-group", "resizable-panels", "scroll-area",
  "select", "sheet", "skeleton", "slider", "spinner", "switch", "tabs",
  "toast", "toggle", "toggle-group", "toolbar", "tooltip", "tree", "virtual-list",
])
const hasComponentExample = COMPONENTS_WITH_EXAMPLES.has(name)

const homePath = locale === "es" ? "/es/" : "/"
const directoryPath = locale === "es" ? `/es/${layer}/` : `/${layer}/`
const currentPath = layerHref(layer, name, locale, view)
const breadcrumbItems = [
  { name: seoCopy.home, pathname: homePath },
  { name: copy.directoryTitle, pathname: directoryPath },
  ...(view === "overview"
    ? []
    : [{ name: document?.data.title ?? name, pathname: layerHref(layer, name, locale) }]),
  {
    name: view === "overview" ? (document?.data.title ?? name) : sectionTitle[view],
    pathname: currentPath,
  },
]

// Build sidebar from all entries in this layer's collection
const allEntries = await getCollection(collectionName, (entry) => entry.data.locale === locale)
const sidebarGroups: DocsSidebarGroup[] = [
  {
    label: copy.directoryTitle,
    links: allEntries
      .map((entry) => ({
        label: entry.data.title ?? entryName(entry.id),
        href: layerHref(layer, entryName(entry.id), locale),
      }))
      .sort((a, b) => a.label.localeCompare(b.label)),
  },
]
---

<DocsLayout
  title={title}
  description={pageDescription}
  sidebarGroups={sidebarGroups}
  structuredData={undefined}
  contentType={layer}
>
  <CatalogBreadcrumbs
    label={seoCopy.breadcrumbs}
    items={breadcrumbItems.map((item, index) => ({
      label: item.name,
      href: index === breadcrumbItems.length - 1 ? undefined : item.pathname,
    }))}
  />
  <header class="primitive-header">
    <h1>{document?.data.title ?? name}</h1>
    <p>{pageDescription}</p>
    <dl class="primitive-header__meta">
      <div><dt>{copy.status}</dt><dd>{document?.data.status ?? "draft"}</dd></div>
    </dl>
  </header>

  {
    view === "overview" && (
      <section>
        <h2>{copy.preview}</h2>
        {hasComponentExample && layer === "components" && (
          <>
            <ComponentExample name={name} locale={locale} />
            <p class="preview-styling-note">
              {locale === "es"
                ? "Este ejemplo usa estilos solo para documentación. En producción, utiliza una de las recetas incluidas (CSS, Tailwind o UnoCSS)."
                : "This preview uses documentation-only styling. Ship with one of the included recipe outputs (CSS, Tailwind, or UnoCSS) for production styles."}
            </p>
          </>
        )}
        {DocumentContent ? <DocumentContent /> : <p>{pageDescription}</p>}
      </section>
    )
  }

  {
    view === "api" && (
      <section>
        <h2>{copy.api}</h2>
        {DocumentContent ? (
          <DocumentContent />
        ) : (
          <p class="catalog-notice" role="status">
            {copy.apiUnavailable}
          </p>
        )}
      </section>
    )
  }

  {
    view === "examples" && (
      <section>
        <h2>{copy.examples}</h2>
        {DocumentContent ? (
          <DocumentContent />
        ) : (
          <p class="catalog-notice" role="status">
            {copy.examplesUnavailable}
          </p>
        )}
        {hasComponentExample && layer === "components" && (
          <ComponentExample name={name} locale={locale} />
        )}
      </section>
    )
  }

  {
    view === "accessibility" && (
      <section>
        <h2>{copy.accessibility}</h2>
        {DocumentContent ? (
          <DocumentContent />
        ) : (
          <p class="catalog-notice" role="status">
            {copy.accessibilityUnavailable}
          </p>
        )}
      </section>
    )
  }
</DocsLayout>
