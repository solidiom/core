---
/**
 * SiteFooter — global footer.
 *
 * Redesigned with four columns:
 *   - Brand: Logo, description, license
 *   - Resources: Docs, GitHub, Changelog, Blog
 *   - Community: Discord, Discussions, Contributing, Code of Conduct
 *   - Stay up to date: Newsletter form + social icons
 */

const year = new Date().getFullYear()

const resourceLinks = [
  { label: "Docs", href: "/primitives/" },
  { label: "GitHub", href: "https://github.com/solidiom" },
  { label: "Changelog", href: "/changelog/" },
  { label: "Blog", href: "https://github.com/solidiom/solidiom/discussions" },
]

const communityLinks = [
  { label: "Discord", href: "https://github.com/solidiom" },
  { label: "Discussions", href: "https://github.com/solidiom/solidiom/discussions" },
  { label: "Contributing", href: "https://github.com/solidiom/solidiom/blob/main/CONTRIBUTING.md" },
  { label: "Code of Conduct", href: "https://github.com/solidiom/solidiom/blob/main/CONTRIBUTING.md" },
]
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <!-- Brand Column -->
    <div class="site-footer__brand">
      <div class="site-footer__logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect width="32" height="32" rx="8" fill="currentColor" opacity="0.1"/>
          <path d="M10 16c0-3.3 2.7-6 6-6s6 2.7 6 6-2.7 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          <circle cx="16" cy="16" r="2" fill="currentColor"/>
        </svg>
        <span class="site-footer__wordmark">Solidiom</span>
      </div>
      <p class="site-footer__description">
        Solidiom is an open source project.<br/>
        Licensed under MIT.
      </p>
    </div>

    <!-- Resources Column -->
    <nav class="site-footer__col" aria-label="Resources">
      <p class="site-footer__col-title">Resources</p>
      <ul class="site-footer__list">
        {resourceLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Community Column -->
    <nav class="site-footer__col" aria-label="Community">
      <p class="site-footer__col-title">Community</p>
      <ul class="site-footer__list">
        {communityLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Stay up to date Column -->
    <div class="site-footer__col site-footer__subscribe">
      <p class="site-footer__col-title">Stay up to date</p>
      <p class="site-footer__subscribe-copy">
        Get updates on new releases, components, and guides.
      </p>
      <form class="site-footer__form" aria-label="Newsletter signup">
        <label class="sr-only" for="footer-email">Email address</label>
        <div class="site-footer__form-row">
          <input
            id="footer-email"
            class="site-footer__input"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="you@example.com"
          />
          <button class="site-footer__submit" type="submit">Subscribe</button>
        </div>
      </form>

      <!-- Social Icons -->
      <div class="site-footer__social">
        <a href="https://github.com/solidiom" aria-label="GitHub" class="site-footer__social-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <a href="https://github.com/solidiom/solidiom/discussions" aria-label="Discussions" class="site-footer__social-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </a>
        <a href="https://twitter.com/solidiom" aria-label="Twitter" class="site-footer__social-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
