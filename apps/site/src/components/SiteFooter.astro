---
/**
 * SiteFooter — global footer.
 *
 * Redesigned with four columns:
 *   - Brand: Logo, description, license
 *   - Resources: Docs, GitHub, Changelog, Blog
 *   - Community: Contributing, Code of Conduct
 *   - Stay up to date: GitHub icon (newsletter form disabled until GA)
 *
 * Internal links are locale-prefixed from the active route locale; the
 * Contributing link targets the on-site guide (`/community/contributing/`),
 * and Code of Conduct points at the Contributor Covenant we follow.
 */
import { localePrefix, type Locale } from "../lib/locale"

interface Props {
  locale?: Locale
}

const { locale = "en" } = Astro.props
const prefix = localePrefix(locale)
const isEs = locale === "es"

const columnTitles = {
  resources: isEs ? "Recursos" : "Resources",
  community: isEs ? "Comunidad" : "Community",
  subscribe: isEs ? "Mantente al día" : "Stay up to date",
}

const resourceLinks = [
  { label: "Docs", href: `${prefix}/primitives/` },
  { label: "GitHub", href: "https://github.com/solidiom/core" },
  { label: "Changelog", href: `${prefix}/changelog/` },
  { label: "Blog", href: `${prefix}/blog/` },
]

const communityLinks = [
  {
    label: isEs ? "Contribuir" : "Contributing",
    href: `${prefix}/community/contributing/`,
  },
  {
    label: isEs ? "Código de conducta" : "Code of Conduct",
    href: "https://www.contributor-covenant.org/version/2/1/code_of_conduct/",
  },
]
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <!-- Brand Column -->
    <div class="site-footer__brand">
      <div class="site-footer__logo">
        <svg
          class="site-footer__logo-mark"
          width="24"
          height="31"
          viewBox="0 0 129 168"
          fill="none"
          aria-hidden="true"
        >
          <!-- Dark-mode mark, version C (multi-colour, retuned for the dark
               footer). Mirrors apps/site/src/assets/brand/symbol-color-dark.svg. -->
          <path d="M60 0H46a46 46 0 0 0 0 92h14z" fill="#F8FAFC"></path>
          <rect x="69" y="0" width="60" height="60" fill="#8B83F8"></rect>
          <rect x="0" y="108" width="60" height="60" fill="#CBD5E1"></rect>
          <path d="M69 76h14a46 46 0 0 1 0 92H69z" fill="#22D3EE"></path>
        </svg>
        <span class="site-footer__wordmark">Solidiom</span>
      </div>
      <p class="site-footer__description">
        {
          isEs ? (
            <>
              Solidiom es un proyecto de código abierto.
              <br />
              Licenciado bajo Apache 2.0.
            </>
          ) : (
            <>
              Solidiom is an open source project.
              <br />
              Licensed under Apache 2.0.
            </>
          )
        }
      </p>
    </div>

    <!-- Resources Column -->
    <nav class="site-footer__col" aria-label={columnTitles.resources}>
      <p class="site-footer__col-title">{columnTitles.resources}</p>
      <ul class="site-footer__list">
        {
          resourceLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Community Column -->
    <nav class="site-footer__col" aria-label={columnTitles.community}>
      <p class="site-footer__col-title">{columnTitles.community}</p>
      <ul class="site-footer__list">
        {
          communityLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Stay up to date Column -->
    <div class="site-footer__col site-footer__subscribe">
      <p class="site-footer__col-title">{columnTitles.subscribe}</p>
      <p class="site-footer__subscribe-copy">
        {
          isEs
            ? "Recibe novedades sobre nuevas versiones, componentes y guías."
            : "Get updates on new releases, components, and guides."
        }
      </p>
      <!-- Newsletter form disabled until GA
      <form class="site-footer__form" aria-label="Newsletter signup">
        <label class="sr-only" for="footer-email">Email address</label>
        <div class="site-footer__form-row">
          <input
            id="footer-email"
            class="site-footer__input"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="you@example.com"
          />
          <button class="site-footer__submit" type="submit">Subscribe</button>
        </div>
      </form>
      -->
      <p class="site-footer__subscribe-copy" style="font-style: italic;">
        {isEs ? "Boletín próximamente." : "Newsletter coming soon."}
      </p>

      <!-- Social Icons -->
      <div class="site-footer__social">
        <a
          href="https://github.com/solidiom/core"
          aria-label="GitHub"
          class="site-footer__social-link"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
            ></path></svg
          >
        </a>
      </div>
    </div>
  </div>
</footer>
