---
/**
 * DOCS-001 primitive directory — lists every registry primitive with a link
 * to its localized overview route. Filtering/status UI is DOCS-004's scope;
 * this is the static, always-available link inventory every locale needs.
 */
import DocsLayout from "../layouts/DocsLayout.astro"
import { catalogDirectoryStructuredData, getCatalogSeoCopy } from "../lib/metadata"
import { categoryLabel, primitiveSidebarGroups } from "../lib/docs-nav"
import {
  getCatalogCopy,
  getRegistryPrimitives,
  primitiveHref,
  type RegistryPrimitive,
} from "../lib/catalog"
import { getMaturityInfo } from "../lib/maturity"
import type { Locale } from "../lib/locale"
import { PrimitiveDirectoryFilters } from "./PrimitiveDirectoryFilters"
import CatalogBreadcrumbs from "./CatalogBreadcrumbs.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = getCatalogCopy(locale)
const primitives = getRegistryPrimitives()
const countLabel = copy.directoryCount.replace("{count}", String(primitives.length))
const maturity = getMaturityInfo("primitives", locale)
const directoryPrimitives = primitives.map((primitive) => ({
  name: primitive.name,
  label: primitive.label,
  description: primitive.description,
  category: primitive.category,
  status: primitive.status,
  href: primitiveHref(primitive.name, locale),
}))
const seoCopy = getCatalogSeoCopy(locale)
const homePath = locale === "es" ? "/es/" : "/"
const directoryPath = locale === "es" ? "/es/primitives/" : "/primitives/"
const breadcrumbItems = [
  { name: seoCopy.home, pathname: homePath },
  { name: copy.directoryTitle, pathname: directoryPath },
]
const structuredData = catalogDirectoryStructuredData({
  title: copy.directoryTitle,
  description: copy.directoryDescription,
  pathname: directoryPath,
  locale,
  breadcrumbs: breadcrumbItems,
  items: directoryPrimitives.map((primitive) => ({
    name: primitive.label,
    pathname: primitive.href,
  })),
})

function categoryLabelFor(primitive: RegistryPrimitive): string {
  return categoryLabel(primitive.category, locale)
}

const sidebarGroups = primitiveSidebarGroups(primitives, locale, (name, loc) =>
  primitiveHref(name, loc),
)
---

<DocsLayout
  title={copy.directoryTitle}
  description={copy.directoryDescription}
  sidebarGroups={sidebarGroups}
  structuredData={structuredData}
>
  <CatalogBreadcrumbs
    label={seoCopy.breadcrumbs}
    items={breadcrumbItems.map((item, index) => ({
      label: item.name,
      href: index === breadcrumbItems.length - 1 ? undefined : item.pathname,
    }))}
  />
  <header class="primitive-directory__header">
    <h1>
      {copy.directoryTitle}
      <span class="maturity-badge__label" data-maturity={maturity.level} title={maturity.tooltip}>
        {maturity.label}
      </span>
    </h1>
    <p>{copy.directoryDescription}</p>
    <p class="primitive-directory__count">{countLabel}</p>
  </header>

  <PrimitiveDirectoryFilters primitives={directoryPrimitives} locale={locale} client:load />

  <div id="primitive-directory-fallback" class="primitive-directory__fallback">
    <ul class="primitive-directory__grid" data-pagefind-ignore="index">
      {
        primitives.map((primitive) => (
          <li class="primitive-directory__item">
            <a href={primitiveHref(primitive.name, locale)} class="primitive-directory__link">
              <span class="primitive-directory__name">{primitive.label}</span>
              <span class="primitive-directory__description">{primitive.description}</span>
              <span class="primitive-directory__meta">
                <span class="primitive-directory__category">{categoryLabelFor(primitive)}</span>
                <span class="primitive-directory__status">{primitive.status}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</DocsLayout>
