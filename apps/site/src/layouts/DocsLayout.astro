---
/**
 * Documentation shell layout (SITE-007).
 *
 * Wraps BaseLayout with the three-region structure every docs/catalog
 * route will share: a left sidebar (generated section/group navigation),
 * a center article column (the actual page content, via the default
 * slot), and a right-side "on this page" table of contents.
 *
 * STATUS: sidebarGroups and toc are populated by callers from real
 * registry/content data (DOCS-003) via ../lib/docs-nav.ts helpers
 * (`primitiveSidebarGroups`, `tocFromHeadings`, `adjacentPrimitiveLinks`).
 * They remain optional props defaulting to empty arrays so any route that
 * doesn't need docs-style navigation can still use this layout.
 *
 * Regions, by breakpoint (single 768px/1024px split, matching the rest of
 * the shell's breakpoint convention):
 *   - < 768px: sidebar is hidden and only reachable via the mobile nav
 *     drawer (DocsMobileNav); TOC is hidden entirely (no room, and "on
 *     this page" is a supplementary aid, not primary navigation).
 *   - 768px–1023px: sidebar visible as a static column; TOC still hidden.
 *   - >= 1024px: sidebar, article, and TOC all visible as three columns.
 *
 * Scroll/focus behavior:
 *   - Sidebar and TOC are `position: sticky` below the sticky header and
 *     independently scrollable when their content exceeds the viewport,
 *     so long link lists never push the article column down.
 *   - Headings inside the article get `scroll-margin-top` (see
 *     docs-layout.css) so anchor/TOC-link navigation doesn't hide the
 *     target under the sticky header.
 *   - The existing skip-link + `mainId` focus-root behavior from
 *     BaseLayout is unchanged: it still targets the whole docs region,
 *     not just the article, since the sidebar is also main-content
 *     navigation on this route type.
 */
import BaseLayout from "./BaseLayout.astro"
import DocsMobileNav from "../components/DocsMobileNav.astro"
import {
  getDocsNavigationCopy,
  type DocsSidebarGroup,
  type DocsTocEntry,
  type DocsAdjacentLink,
} from "../lib/docs-nav"
import { resolveLocale } from "../lib/locale"
import type { JsonLd } from "../lib/metadata"

export interface BlogAuthorMeta {
  avatar: string
  name: string
  description: string
  github?: string | null
  linkedin?: string | null
  website?: string | null
}

export interface BlogMeta {
  authors: BlogAuthorMeta[]
  date: Date
  tags: string[]
}

interface Props {
  title?: string
  description?: string
  sidebarGroups?: DocsSidebarGroup[]
  toc?: DocsTocEntry[]
  previous?: DocsAdjacentLink
  next?: DocsAdjacentLink
  structuredData?: JsonLd | JsonLd[]
  contentType?: string
  blogMeta?: BlogMeta
}

const {
  title,
  description,
  sidebarGroups = [],
  toc = [],
  previous,
  next,
  structuredData,
  contentType,
  blogMeta,
} = Astro.props

const pathname = Astro.url.pathname
const locale = resolveLocale(pathname)
const copy = getDocsNavigationCopy(locale)
const isActive = (href: string) => pathname === href
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
  mainId="docs-content"
>
  <div class="docs-shell">
    <div class="docs-shell__mobile-bar">
      <DocsMobileNav groups={sidebarGroups} copy={copy} />
      <span class="docs-shell__mobile-label">{copy.title}</span>
    </div>

    <div class="docs-shell__grid">
      <aside class="docs-shell__sidebar" aria-label={copy.navigationLabel}>
        {
          sidebarGroups.length > 0 ? (
            <nav>
              {sidebarGroups.map((group) => (
                <div class="docs-shell__sidebar-group">
                  <p class="docs-shell__sidebar-group-label">{group.label}</p>
                  <ul>
                    {group.links.map((link) => (
                      <li>
                        <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </nav>
          ) : (
            <p class="docs-shell__sidebar-empty">{copy.noSections}</p>
          )
        }
      </aside>

      <article
        class="docs-shell__article prose"
        data-pagefind-body
        data-pagefind-filter-locale={locale}
        data-pagefind-filter-content_type={contentType}
        data-pagefind-meta={`title:${title ?? ""}`}
      >
        <slot />

        {
          (previous || next) && (
            <nav class="docs-shell__adjacent" aria-label={copy.adjacentPages}>
              {previous ? (
                <a
                  class="docs-shell__adjacent-link docs-shell__adjacent-link--previous"
                  href={previous.href}
                >
                  <span class="docs-shell__adjacent-direction">{copy.previous}</span>
                  <span class="docs-shell__adjacent-label">{previous.label}</span>
                </a>
              ) : (
                <span />
              )}
              {next ? (
                <a
                  class="docs-shell__adjacent-link docs-shell__adjacent-link--next"
                  href={next.href}
                >
                  <span class="docs-shell__adjacent-direction">{copy.next}</span>
                  <span class="docs-shell__adjacent-label">{next.label}</span>
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </article>

      <aside class="docs-shell__toc" aria-label={copy.onThisPage}>
        {blogMeta && (
          <div class="docs-shell__blog-meta">
            <p class="docs-shell__toc-label">{locale === "es" ? "Artículo" : "Article"}</p>
            <dl class="docs-shell__blog-meta--info">
              <div class="docs-shell__blog-meta--date">
                <dt>{locale === "es" ? "Publicado" : "Published"}</dt>
                <dd>
                  {blogMeta.date.toLocaleDateString(locale === "es" ? "es-ES" : "en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </dd>
              </div>
              {blogMeta.tags.length > 0 && (
                <div class="docs-shell__blog-meta--tags">
                  <dt>{locale === "es" ? "Etiquetas" : "Tags"}</dt>
                  <dd>{blogMeta.tags.join(", ")}</dd>
                </div>
              )}
            </dl>
            <p class="docs-shell__toc-label">{locale === "es" ? "Autor" : "Author"}</p>
            {blogMeta.authors.map((author) => (
              <div class="docs-shell__blog-meta--author">
                <img
                  class="docs-shell__blog-meta--avatar"
                  src={author.avatar}
                  alt={`${author.name} avatar`}
                  loading="lazy"
                  width="48"
                  height="48"
                />
                <div class="docs-shell__blog-meta--info">
                  <p class="docs-shell__blog-meta--name">
                    {author.website ? (
                      <a href={author.website} target="_blank" rel="noopener noreferrer">{author.name}</a>
                    ) : (
                      author.name
                    )}
                  </p>
                  <p class="docs-shell__blog-meta--bio">{author.description}</p>
                  <div class="docs-shell__blog-meta--links">
                    {author.github && (
                      <a href={`https://github.com/${author.github}`} target="_blank" rel="noopener noreferrer" aria-label={`${author.name} on GitHub`}>
                        GitHub
                      </a>
                    )}
                    {author.linkedin && (
                      <a href={`https://linkedin.com/in/${author.linkedin}`} target="_blank" rel="noopener noreferrer" aria-label={`${author.name} on LinkedIn`}>
                        LinkedIn
                      </a>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
        {
          toc.length > 0 && (
            <nav>
              <p class="docs-shell__toc-label">{copy.onThisPage}</p>
              <ul>
                {toc.map((entry) => (
                  <li class={`docs-shell__toc-item docs-shell__toc-item--depth-${entry.depth}`}>
                    <a href={`#${entry.id}`}>{entry.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import { initCopyCodeButtons } from "../lib/copy-code"

  initCopyCodeButtons()
</script>
