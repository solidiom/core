---
/**
 * Base document/layout for every static route on the Solidiom site.
 *
 * Responsibilities (SITE-004 + SITE-009 + SITE-010):
 *   - Base HTML shell with correct lang/dir per route locale.
 *   - Metadata defaults (title template, description, canonical link).
 *   - Social/Open Graph metadata via resolveSocialMetadata helper.
 *   - hreflang alternates via resolveHreflangAlternates helper.
 *   - Font preload links (placeholder targets pending BRAND-003).
 *   - Web app manifest link.
 *   - No-flash locale/theme bootstrap (data-theme set before first paint).
 *   - Skip link and a single focus-root landmark for main content.
 *
 * Explicitly out of scope here (see docs/website-tasks.md §5.1):
 *   - Docs shell (SITE-007 — see DocsLayout).
 *
 * Typography/prose/code styling (SITE-008) is global CSS imported via
 * global.css (prose.css/code.css/callouts.css/print.css) and applies
 * wherever routes opt in via the `.prose` class — no changes needed here.
 *
 * Footer (SITE-006) is implemented via SiteFooter below.
 */
import "../assets/global.css"
import { bootstrapThemeScript } from "../lib/bootstrap-theme"
import { resolveLocale, localeDirection } from "../lib/locale"
import {
  resolvePageMetadata,
  resolveSocialMetadata,
  resolveHreflangAlternates,
} from "../lib/metadata"
import { primaryLinks, resourceLinks } from "../lib/nav-links"
import SiteHeader from "../components/SiteHeader.astro"
import SiteFooter from "../components/SiteFooter.astro"

interface Props {
  title?: string
  description?: string
  /** Path to social card image, relative to site root. */
  image?: string
  /** Alt text for social card image. */
  imageAlt?: string
  /** Open Graph type override (default "website"). */
  ogType?: string
  /** Article publish date (ISO 8601). */
  publishedTime?: string
  /** Id of the element the skip link and focus root should target. Defaults to "main-content". */
  mainId?: string
  /**
   * Whether to render the global header/nav. Default true. Routes that must
   * not import interactive shell chrome (e.g. a future playground/theme
   * builder, per SITE-012's import-boundary rules) can opt out.
   */
  showHeader?: boolean
  /** Whether to render the global footer. Default true. */
  showFooter?: boolean
}

const {
  title,
  description,
  image,
  imageAlt,
  ogType,
  publishedTime,
  mainId = "main-content",
  showHeader = true,
  showFooter = true,
} = Astro.props

const locale = resolveLocale(Astro.url.pathname)
const dir = localeDirection(locale)
const metadata = resolvePageMetadata({
  title,
  description,
  pathname: Astro.url.pathname,
  locale,
})

const social = resolveSocialMetadata({
  title: metadata.title,
  description: metadata.description,
  canonicalUrl: metadata.canonicalUrl,
  image,
  imageAlt,
  type: ogType,
  publishedTime,
})

const alternates = resolveHreflangAlternates(Astro.url.pathname, locale)
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <link rel="canonical" href={metadata.canonicalUrl} />

    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <meta property="og:type" content={social["og:type"]} />
    <meta property="og:site_name" content={social["og:site_name"]} />
    <meta property="og:title" content={social["og:title"]} />
    <meta property="og:description" content={social["og:description"]} />
    <meta property="og:url" content={social["og:url"]} />
    {social["og:image"] && <meta property="og:image" content={social["og:image"]} />}
    {social["og:image:alt"] && <meta property="og:image:alt" content={social["og:image:alt"]} />}
    {social["article:published_time"] && <meta property="article:published_time" content={social["article:published_time"]} />}
    <meta name="twitter:card" content={social["twitter:card"]} />
    <meta name="twitter:title" content={social["twitter:title"]} />
    <meta name="twitter:description" content={social["twitter:description"]} />
    {social["twitter:image"] && <meta name="twitter:image" content={social["twitter:image"]} />}
    {social["twitter:image:alt"] && <meta name="twitter:image:alt" content={social["twitter:image:alt"]} />}

    <link rel="manifest" href="/manifest.webmanifest" />

    <!--
      Font preloads: placeholder pending BRAND-003 (self-hosted Inter Tight,
      Inter Variable, IBM Plex Mono). No font binaries exist in the repo yet,
      so there is nothing to preload without generating 404s. Re-enable these
      once BRAND-003 lands and update the hrefs to the real self-hosted paths.
    -->
    <!--
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-tight-variable.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-variable.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-mono-variable.woff2" crossorigin />
    -->

    <!--
      No-flash theme bootstrap: must be a blocking, synchronous script
      placed before any stylesheet/content so `data-theme` is set on <html>
      before first paint. Locale is already resolved server-side above and
      needs no client script.
    -->
    <script is:inline set:html={bootstrapThemeScript()} />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href={`#${mainId}`}>Skip to main content</a>
    {showHeader && <SiteHeader links={primaryLinks} resourceLinks={resourceLinks} homeHref="/" />}
    <main id={mainId} class="focus-root" tabindex="-1">
      <slot />
    </main>
    {showFooter && <SiteFooter />}
  </body>
</html>
