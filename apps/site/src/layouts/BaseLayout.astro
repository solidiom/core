---
/**
 * Shared static document shell. Locale is resolved from the requested path;
 * a stored choice is exposed to controls but never changes the route.
 */
import "../assets/global.css"
import { bootstrapThemeScript } from "../lib/bootstrap-theme"
import {
  bootstrapLocalePreferenceScript,
  localeDirection,
  resolveEquivalentLocalePath,
  resolveLocale,
} from "../lib/locale"
import {
  resolveHreflangAlternates,
  resolvePageMetadata,
  resolveSocialMetadata,
} from "../lib/metadata"
import { primaryLinks, resourceLinks } from "../lib/nav-links"
import SiteHeader from "../components/SiteHeader.astro"
import SiteFooter from "../components/SiteFooter.astro"

interface Props {
  title?: string
  description?: string
  image?: string
  imageAlt?: string
  ogType?: string
  publishedTime?: string
  mainId?: string
  showHeader?: boolean
  showFooter?: boolean
}

const {
  title,
  description,
  image,
  imageAlt,
  ogType,
  publishedTime,
  mainId = "main-content",
  showHeader = true,
  showFooter = true,
} = Astro.props

const locale = resolveLocale(Astro.url.pathname)
const dir = localeDirection(locale)
const metadata = resolvePageMetadata({
  title,
  description,
  pathname: Astro.url.pathname,
  locale,
})
const social = resolveSocialMetadata({
  title: metadata.title,
  description: metadata.description,
  canonicalUrl: metadata.canonicalUrl,
  image,
  imageAlt,
  type: ogType,
  publishedTime,
})
const alternates = resolveHreflangAlternates(Astro.url.pathname, locale)
const homeHref = resolveEquivalentLocalePath("/", locale) ?? "/"
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <link rel="canonical" href={metadata.canonicalUrl} />

    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

    <meta property="og:type" content={social["og:type"]} />
    <meta property="og:site_name" content={social["og:site_name"]} />
    <meta property="og:title" content={social["og:title"]} />
    <meta property="og:description" content={social["og:description"]} />
    <meta property="og:url" content={social["og:url"]} />
    {social["og:image"] && <meta property="og:image" content={social["og:image"]} />}
    {social["og:image:alt"] && <meta property="og:image:alt" content={social["og:image:alt"]} />}
    {
      social["article:published_time"] && (
        <meta property="article:published_time" content={social["article:published_time"]} />
      )
    }
    <meta name="twitter:card" content={social["twitter:card"]} />
    <meta name="twitter:title" content={social["twitter:title"]} />
    <meta name="twitter:description" content={social["twitter:description"]} />
    {social["twitter:image"] && <meta name="twitter:image" content={social["twitter:image"]} />}
    {
      social["twitter:image:alt"] && (
        <meta name="twitter:image:alt" content={social["twitter:image:alt"]} />
      )
    }

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon-192.svg" type="image/svg+xml" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-tight-variable.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-variable.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/ibm-plex-mono-variable.woff2"
      crossorigin
    />

    <script is:inline set:html={bootstrapThemeScript()} />
    <script is:inline set:html={bootstrapLocalePreferenceScript()} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href={`#${mainId}`}>Skip to main content</a>
    {
      showHeader && (
        <SiteHeader
          links={primaryLinks}
          resourceLinks={resourceLinks}
          homeHref={homeHref}
          locale={locale}
        />
      )
    }
    <main id={mainId} class="focus-root" tabindex="-1">
      <slot />
    </main>
    {showFooter && <SiteFooter />}
    <script is:inline>
      {
        ;`document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const skipLink = target.closest(".skip-link");
        if (!(skipLink instanceof HTMLAnchorElement)) return;
        const focusTarget = document.getElementById(skipLink.hash.slice(1));
        if (focusTarget instanceof HTMLElement) focusTarget.focus();
      });`
      }
    </script>
  </body>
</html>
