{
  "name": "@solidiom/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "search-index": "pagefind --site dist",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/sitemap": "3.7.3",
    "@solidiom/astrojs-solid-next": "workspace:*",
    "@solidiom/drawer": "workspace:*",
    "@solidiom/navigation-menu": "workspace:*",
    "@solidjs/web": "catalog:",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.3",
    "cookie": "2.0.1",
    "github-slugger": "2.0.0",
    "hastscript": "9.0.1",
    "shiki": "3.23.0",
    "solid-js": "catalog:",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/hast": "3.0.5",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "nx": {
    "tags": [
      "layer:app"
    ],
    "targets": {
      "dev": {
        "cache": false
      },
      "check": {
        "inputs": [
          "default",
          "^default"
        ],
        "cache": true
      },
      "build": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true
      },
      "preview": {
        "cache": false
      },
      "search-index": {
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist/pagefind"
        ],
        "cache": true
      },
      "test:e2e": {
        "cache": false
      }
    }
  }
}
