{
  "name": "@solidiom/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run templates:sync && astro dev",
    "check": "astro check",
    "lint": "eslint .",
    "boundaries": "tsx ./tools/validate-site-import-boundaries.ts",
    "test:boundaries": "pnpm run boundaries -- --self-test",
    "budget-report": "tsx ./tools/report-route-budgets.ts",
    "budget-report:enforce": "tsx ./tools/report-route-budgets.ts --enforce",
    "route-parity": "tsx ./tools/validate-route-parity.ts",
    "registry-route-check": "tsx ./tools/validate-registry-route-invariant.ts",
    "content:validate": "tsx ./tools/validate-content-collections.ts",
    "translation:check": "tsx ./tools/validate-translation-freshness.ts",
    "i18n:validate": "pnpm run route-parity && pnpm run content:validate && pnpm run translation:check",
    "lighthouse": "tsx ./tools/lighthouse-report.ts",
    "lighthouse:json": "tsx ./tools/lighthouse-report.ts --json",
    "api": "pnpm --dir ../.. api:generate",
    "build": "pnpm run templates:sync && pnpm run i18n:validate && pnpm run boundaries && astro build",
    "preview": "astro preview",
    "search-index": "pagefind --site dist",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "UPDATE_SNAPSHOTS=1 playwright test --config playwright.visual.config.ts",
    "templates:sync": "tsx ./tools/sync-template-previews.ts",
    "verify:preview": "tsx ./tools/verify-preview-deployment.ts"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/sitemap": "3.7.3",
    "@solidiom/astrojs-solid-next": "workspace:*",
    "@solidiom/combobox": "workspace:*",
    "@solidiom/accordion": "workspace:*",
    "@solidiom/alert": "workspace:*",
    "@solidiom/alert-dialog": "workspace:*",
    "@solidiom/avatar": "workspace:*",
    "@solidiom/breadcrumb": "workspace:*",
    "@solidiom/badge": "workspace:*",
    "@solidiom/button": "workspace:*",
    "@solidiom/calendar": "workspace:*",
    "@solidiom/card": "workspace:*",
    "@solidiom/carousel": "workspace:*",
    "@solidiom/checkbox": "workspace:*",
    "@solidiom/collapsible": "workspace:*",
    "@solidiom/command-palette": "workspace:*",
    "@solidiom/context-menu": "workspace:*",
    "@solidiom/data-table": "workspace:*",
    "@solidiom/date-picker": "workspace:*",
    "@solidiom/dialog": "workspace:*",
    "@solidiom/drawer": "workspace:*",
    "@solidiom/empty-state": "workspace:*",
    "@solidiom/field": "workspace:*",
    "@solidiom/menu": "workspace:*",
    "@solidiom/meter": "workspace:*",
    "@solidiom/hover-card": "workspace:*",
    "@solidiom/input": "workspace:*",
    "@solidiom/input-otp": "workspace:*",
    "@solidiom/kbd": "workspace:*",
    "@solidiom/label": "workspace:*",
    "@solidiom/listbox": "workspace:*",
    "@solidiom/progress": "workspace:*",
    "@solidiom/select": "workspace:*",
    "@solidiom/separator": "workspace:*",
    "@solidiom/slider": "workspace:*",
    "@solidiom/spinner": "workspace:*",
    "@solidiom/switch": "workspace:*",
    "@solidiom/tabs": "workspace:*",
    "@solidiom/toggle": "workspace:*",
    "@solidiom/toast": "workspace:*",
    "@solidiom/toggle-group": "workspace:*",
    "@solidiom/toolbar": "workspace:*",
    "@solidiom/tooltip": "workspace:*",
    "@solidiom/tree": "workspace:*",
    "@solidiom/navigation-menu": "workspace:*",
    "@solidiom/pagination": "workspace:*",
    "@solidiom/popover": "workspace:*",
    "@solidiom/resizable-panels": "workspace:*",
    "@solidiom/radio-group": "workspace:*",
    "@solidiom/scroll-area": "workspace:*",
    "@solidiom/sheet": "workspace:*",
    "@solidiom/skeleton": "workspace:*",
    "@solidiom/virtual-list": "workspace:*",
    "@solidiom/visually-hidden": "workspace:*",
    "@solidjs/web": "catalog:",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.3",
    "cookie": "2.0.1",
    "github-slugger": "2.0.0",
    "hastscript": "9.0.1",
    "shiki": "3.23.0",
    "solid-js": "catalog:",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.0",
    "@playwright/test": "1.61.1",
    "@types/hast": "3.0.5",
    "@typescript-eslint/parser": "^8.65.0",
    "astro-eslint-parser": "3.0.0",
    "eslint-plugin-astro": "3.0.1",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "nx": {
    "tags": [
      "layer:app"
    ],
    "targets": {
      "dev": {
        "cache": false
      },
      "check": {
        "inputs": [
          "default",
          "^default"
        ],
        "cache": true
      },
      "lint": {
        "inputs": [
          "default"
        ],
        "cache": true
      },
      "boundaries": {
        "inputs": [
          "default"
        ],
        "cache": true
      },
      "test:boundaries": {
        "cache": false
      },
      "api": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/package.json",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/pnpm-lock.yaml",
          "{workspaceRoot}/tsconfig.base.json",
          "{workspaceRoot}/tools/generate-api-docs.ts",
          "{workspaceRoot}/tools/api-schema.ts",
          "{workspaceRoot}/packages/*/package.json",
          "{workspaceRoot}/packages/*/tsconfig.json",
          "{workspaceRoot}/packages/*/src/**/*",
          "{workspaceRoot}/packages/*/source/**/*"
        ],
        "outputs": [
          "{workspaceRoot}/artifacts/api"
        ],
        "cache": true
      },
      "budget-report": {
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist/budget-report.json"
        ],
        "cache": true
      },
      "budget-report:enforce": {
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "cache": false
      },
      "registry-route-check": {
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/registry/index.json"
        ],
        "cache": true
      },
      "build": {
        "dependsOn": [
          "api",
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true
      },
      "preview": {
        "cache": false
      },
      "search-index": {
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist/pagefind"
        ],
        "cache": true
      },
      "test:e2e": {
        "cache": false
      }
    }
  }
}
