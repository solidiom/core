# OPS-004: Production security and cache headers for all routes.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'strict-dynamic'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.posthog.com; frame-src 'none'; base-uri 'self'; form-action 'self' https://buttondown.com; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-DNS-Prefetch-Control: on
  X-Download-Options: noopen

# OPS-004: Hashed Astro assets — content-addressed, safe for 1-year immutable cache.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# OPS-004: Static fonts — versioned, safe for 1-year immutable cache.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# OPS-004: Pagefind search index — rebuilt per deploy; stale tolerance for search availability.
/pagefind/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# OPS-004: Favicons and web manifest — rarely change, cache for a day.
/favicon.*
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Cache-Control: public, max-age=86400

# OPS-004: Sitemap and robots — revalidate daily.
/sitemap*.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400
