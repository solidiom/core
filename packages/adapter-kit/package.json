{
  "name": "@solidiom/adapter-kit",
  "version": "0.2.0",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Adapter authoring kit — scaffold template and conformance harness for building Solidiom adapters backed by framework-neutral engines.",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./conformance": {
      "import": "./dist/conformance.js",
      "types": "./dist/conformance.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "vitest": "^4.1.11"
  },
  "nx": {
    "tags": [
      "layer:tooling"
    ]
  }
}
