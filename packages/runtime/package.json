{
  "name": "@solidiom/runtime",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "solid": "./source/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "solid": "./source/*.ts",
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "source",
    "src"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "solid-js": "catalog:"
  },
  "nx": {
    "tags": [
      "layer:runtime"
    ]
  }
}
