{
  "name": "@solidiom/astrojs-solid-next",
  "version": "0.4.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Astro integration that renders Solid 2 components as islands using the Solidiom/Vite Solid 2 toolchain.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client.js": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server.js": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./container-renderer": {
      "types": "./dist/container-renderer.d.ts",
      "import": "./dist/container-renderer.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vite-plugin-solid": "3.0.0-next.27"
  },
  "peerDependencies": {
    "@solidjs/web": "catalog:",
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "solid-js": "catalog:",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@solidjs/web": "catalog:",
    "astro": "^7.1.0",
    "solid-js": "catalog:",
    "typescript": "~6.0.3",
    "vite": "^8.1.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "nx": {
    "tags": [
      "layer:integration"
    ]
  }
}
