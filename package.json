{
  "name": "@solidiom/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Solidiom — Solid 2-native UI system",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "graph": "nx graph",
    "registry:build": "tsx tools/registry-build.ts",
    "audit:primitives": "tsx tools/audit-primitives.ts",
    "primitive:gate": "tsx tools/primitive-completion-gate.ts",
    "primitive:audit": "tsx tools/primitive-completion-gate.ts --audit-only",
    "gate:phase0": "tsx tools/phase0-gate.ts",
    "test:a11y": "tsx tools/run-a11y.ts",
    "report:axe": "tsx tools/generate-axe-report.ts",
    "report:a11y-evidence": "tsx tools/a11y-evidence.ts",
    "a11y:coverage-gate": "tsx tools/a11y-coverage-gate.ts",
    "audit:recipe-drift": "tsx tools/audit-recipe-dual-emission.ts",
    "audit:umbrella-purity": "tsx tools/audit-umbrella-purity.ts",
    "gate:phase1": "tsx tools/phase1-gate.ts",
    "gate:phase2": "tsx tools/phase2-gate.ts",
    "gate:phase3": "tsx tools/phase3-gate.ts",
    "gate:phase3-preflight": "tsx tools/phase3-preflight.ts",
    "api:generate": "tsx tools/generate-api-docs.ts",
    "api:coverage-gate": "tsx tools/api-coverage-gate.ts",
    "deps:check": "tsx scripts/check-library-updates.mts",
    "deps:check:ci": "tsx scripts/check-library-updates.mts --fail-on-outdated"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@nx/eslint-plugin": "^23.1.0",
    "@nx/js": "^23.1.0",
    "@playwright/test": "1.61.1",
    "@solidjs/testing-library": "^0.8.10",
    "@solidjs/web": "2.0.0-beta.26",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "axe-core": "4.10.2",
    "eslint": "^10.7.0",
    "expect-type": "^1.4.0",
    "jsdom": "^26.0.0",
    "nx": "^23.1.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "solid-js": "2.0.0-beta.26",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typedoc": "0.28.20",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-solid": "3.0.0-next.15",
    "vitest": "^4.1.10"
  }
}
